# Roomz environment variables. Copy this file to .env and adjust as needed.
# .env is loaded automatically at startup.
# Paths here must match mpd/mpd.conf. Roomz does not start MPD.

# Music directory. MPD's music_directory must be this path.
# Leave unset to use the project data/ directory.
# ROOMZ_LIBRARY_BASE=/mnt/media/music

# MPD protocol. Defaults: 127.0.0.1:6600
# MPD_HOST=127.0.0.1
# MPD_PORT=6600

# PCM FIFO MPD writes and Roomz reads.
# ROOMZ_FIFO=/tmp/roomz-audio.fifo
