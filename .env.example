# Roomz-only settings. Music directory, FIFO, and MPD address come from mpd/mpd.conf.
# .env is loaded automatically at startup. Roomz does not start MPD.

# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Browser/client logs on the server (logger roomz.client). Off unless set.
# CLIENT_LOG_LEVEL=WARNING

# When set, clients must send { "type": "hello", "token": "..." } before client_log is accepted.
# ROOMZ_CLIENT_TOKEN=change-me

# Set only when MPD was started with a file other than mpd/mpd.conf in this repo.
# ROOMZ_MPD_CONF=/etc/mpd.conf
